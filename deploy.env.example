# Deployment settings for scripts/build-tenant-image.sh — copy this file to
# `deploy.env` (gitignored) and fill it in. Nothing here is needed to run
# Hearthloom on your own computer; it is only for publishing a container
# image that a hosting provisioner (Hearthlaunch is one example) runs.

# Fly.io organisation and app whose registry holds the image
# (registry.fly.io/<TENANT_APP>:<tag>). Both are required.
TENANT_ORG=
TENANT_APP=

# Settings baked into the image as defaults (leave empty for none):
#   the ember registry and update source the hosted nodes use, and the
#   provisioner that controls them (it also needs the per-tenant
#   HEARTHLOOM_PROVISIONER_SECRET, which the provisioner sets per machine).
HEARTHLOOM_REGISTRY_URL=
HEARTHLOOM_PROVISIONER_URL=
